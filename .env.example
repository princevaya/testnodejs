PORT=5000
NODE_ENV=production

DB_HOST=db
DB_PORT=3306
DB_USER=testnodejs
DB_PASSWORD=testnodejs_password
DB_NAME=testnodejs
MYSQL_ROOT_PASSWORD=root_password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE_MB=5

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=user@example.com
EMAIL_PASS=replace-with-email-password
EMAIL_FROM="Smart Complaint System <user@example.com>"

GOOGLE_SERVICE_ACCOUNT_FILE=/app/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-sheet-id

UPLOAD_DIR=uploads